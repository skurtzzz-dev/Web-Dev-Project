{
  "name": "FilipinOnly - 04 Update Order Status",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "filipinonly-order-update",
        "responseMode": "responseNode",
        "options": {}
      },
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [
        -700,
        0
      ],
      "id": "3c07c7b8-c016-4aa2-9ff7-32efe72afe52",
      "name": "Update Order Status Webhook",
      "webhookId": "01f03754-a729-465b-a62d-d59627739166"
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const input = $input.first().json;\nconst body = input.body ?? input;\nconst order_number = String(body.order_number ?? '').trim().toUpperCase();\nconst order_status = String(body.order_status ?? '').trim();\nconst allowed = ['Order received','Preparing','On the way','Delivered'];\nif (!order_number) throw new Error('order_number is required');\nif (!allowed.includes(order_status)) throw new Error('Invalid order_status');\nreturn [{ json: {\n  order_number,\n  order_status,\n  updated_at: String(body.updated_at ?? new Date().toISOString()),\n  status_history_json: String(body.status_history_json ?? '[]')\n} }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -450,
        0
      ],
      "id": "8c3841cb-1978-4012-b6c4-9a90f8d11dcb",
      "name": "Validate Status Update"
    },
    {
      "parameters": {
        "resource": "row",
        "operation": "update",
        "dataTableId": {
          "__rl": true,
          "value": "FilipinOnlyOrders",
          "mode": "name"
        },
        "matchType": "allConditions",
        "filters": {
          "conditions": [
            {
              "keyName": "order_number",
              "condition": "eq",
              "keyValue": "={{ $json.order_number }}"
            }
          ]
        },
        "columns": {
          "mappingMode": "autoMapInputData",
          "value": {}
        },
        "options": {}
      },
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
      "position": [
        -160,
        0
      ],
      "id": "ff4edb2a-d6d8-4bee-9829-26b18b61af11",
      "name": "Update Order Row",
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { ok: $input.all().some(item => item.json.order_number), message: $input.all().some(item => item.json.order_number) ? 'Order status updated.' : 'Order number was not found.' } }}",
        "options": {
          "responseCode": 200
        }
      },
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.4,
      "position": [
        120,
        0
      ],
      "id": "0c04709f-de4f-46b5-905c-dfe0d661c1b3",
      "name": "Return Status Update"
    }
  ],
