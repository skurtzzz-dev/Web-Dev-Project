{
  "name": "FilipinOnly - 02 Get Order",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "filipinonly-order-get",
        "responseMode": "responseNode",
        "options": {}
      },
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [
        -700,
        0
      ],
      "id": "11ce04d2-1992-4428-8950-f943402f2b8e",
      "name": "Get Order Webhook",
      "webhookId": "5dfef0ab-8c45-4913-aa6d-7f5b92eb7759"
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const input = $input.first().json;\nconst body = input.body ?? input;\nconst order_number = String(body.order_number ?? '').trim().toUpperCase();\nif (!order_number) throw new Error('order_number is required');\nreturn [{ json: { order_number } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -450,
        0
      ],
      "id": "9679d463-6c2c-483e-86a6-d578c00fd4fa",
      "name": "Read Order Number"
    },
    {
      "parameters": {
        "resource": "row",
        "operation": "get",
        "dataTableId": {
          "__rl": true,
          "value": "FilipinOnlyOrders",
          "mode": "name"
        },
        "matchType": "allConditions",
        "filters": {
          "conditions": [
            {
              "keyName": "order_number",
              "condition": "eq",
              "keyValue": "={{ $json.order_number }}"
            }
          ]
        },
        "returnAll": false,
        "limit": 1,
        "options": {}
      },
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
      "position": [
        -160,
        0
      ],
      "id": "907cdc49-90f8-4158-98c2-0c2ded39e6ea",
      "name": "Find Order",
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { ok: $input.all().some(item => item.json.order_number), order: $input.all().find(item => item.json.order_number)?.json ?? null, message: $input.all().some(item => item.json.order_number) ? 'Order found.' : 'Order not found.' } }}",
        "options": {
          "responseCode": 200
        }
      },
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.4,
      "position": [
        120,
        0
      ],
      "id": "9ceafa6d-0d1d-47eb-a6c5-d56f4eb7796e",
      "name": "Return Order"
    }
  ],
